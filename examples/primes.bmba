# Sieve of Eratosthenes.
fn primes_up_to(n) {
  let is_prime = [true] * (n + 1)
  is_prime[0] = false
  is_prime[1] = false
  let i = 2
  while i * i <= n {
    if is_prime[i] {
      let j = i * i
      while j <= n {
        is_prime[j] = false
        j += i
      }
    }
    i += 1
  }
  return filter(range(n + 1), fn(k) => is_prime[k])
}

let primes = primes_up_to(100)
print("{len(primes)} primes below 100:")
print(primes)
