# "Objects" with maps and closures.
fn Account(owner, balance = 0) {
  let history = []
  let self = {owner: owner}

  self.deposit = fn(amount) {
    if amount <= 0 { throw "deposit must be positive" }
    balance += amount
    push(history, "+{amount}")
  }
  self.withdraw = fn(amount) {
    if amount > balance { throw "insufficient funds for {owner}" }
    balance -= amount
    push(history, "-{amount}")
  }
  self.balance = fn() => balance
  self.history = fn() => copy(history)
  return self
}

let acc = Account("Remco", 50)
acc.deposit(100)
acc.withdraw(30)
try {
  acc.withdraw(1000)
} catch e {
  print("error:", e)
}
print("{acc.owner} has {acc.balance()} after {acc.history()}")
